<?xml version="1.0" encoding="utf-8"?>
<!-- Driving mode: audio-only controls with very large touch targets. Always dark, like the player. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    tools:context="org.schabi.newpipe.player.DrivingModeActivity">

    <!-- cover image of the current video, blurred in code -->
    <ImageView
        android:id="@+id/drivingBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- dark veil (70% black) so white text and icons stay readable over any cover image -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:id="@+id/drivingContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top row: close, title, shuffle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/drivingClose"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:alpha="0.7"
                android:contentDescription="@string/close"
                android:focusable="true"
                android:padding="28dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drivingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="The video title, which can be quite long" />

                <TextView
                    android:id="@+id/drivingChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="Channel name" />
            </LinearLayout>

            <!-- shuffle: dim when off, bright when on (set in code) -->
            <ImageView
                android:id="@+id/drivingShuffle"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:alpha="0.35"
                android:contentDescription="@string/notification_action_shuffle"
                android:focusable="true"
                android:padding="20dp"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- three giant touch zones: previous, play/pause (widest), next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/drivingPrevious"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/previous_stream"
                android:focusable="true">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_previous"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/drivingPlayPause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:contentDescription="@string/pause"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drivingPlayPauseIcon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/drivingNext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/next_stream"
                android:focusable="true">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_next"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- progress: display only, seeking is done by swiping -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <ProgressBar
                android:id="@+id/drivingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/progress_youtube_horizontal_dark" />

            <TextView
                android:id="@+id/drivingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="12:04 / 45:10" />
        </LinearLayout>
    </LinearLayout>

    <!-- flashes "+10 seconds" / "-10 seconds" after a swipe, then fades out -->
    <TextView
        android:id="@+id/drivingSeekLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:alpha="0"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:alpha="1"
        tools:text="+10 seconds" />

</FrameLayout>
