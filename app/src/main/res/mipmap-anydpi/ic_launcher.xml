<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 6 and 7, which do not have adaptive icons:
     the Loki logo on a charcoal circle. Newer versions use mipmap-anydpi-v26. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:drawable="@drawable/ic_loki_logo"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp" />
</layer-list>
